# Copy this file to `.env` and fill in your Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model for the 5-agent Council (overrideable in UI)
DEFAULT_MODEL=gemini-3.5-flash-lite

# Option B: 3 distinct models for the 3 blank, character-free Meta-Judges (comma-separated)
META_JUDGE_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash

# Default number of Stage 2 open debate rounds (1 to 3)
DEBATE_ROUNDS=2
